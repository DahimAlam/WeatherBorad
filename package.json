    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
