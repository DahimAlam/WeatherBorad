# Browser-visible API credentials. Never use private server secrets in VITE_*.
# No keys needed for Open-Meteo weather and free GeoDB city search.
VITE_OPENWEATHER_API_KEY=
# geodb-free (default), rapidapi, or open-meteo
VITE_CITY_SEARCH_PROVIDER=geodb-free
VITE_GEODB_API_KEY=
# Optional HTTPS push scheduling service; see README for its contract.
VITE_PUSH_API_URL=
VITE_VAPID_PUBLIC_KEY=
